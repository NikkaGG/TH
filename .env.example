# Generate .env with: python tools/setup_api.py
# No secrets below are usable defaults. Do not commit .env.
LH_ADMIN_KEY=CHANGE_ME_ADMIN_RANDOM_32_PLUS
LH_OPERATOR_KEY=CHANGE_ME_OPERATOR_RANDOM_32_PLUS
LH_VIEWER_KEY=CHANGE_ME_VIEWER_RANDOM_32_PLUS
LH_ENCRYPTION_KEYS=CHANGE_ME_FERNET_KEY

# Local mode: SQLite and one separate local worker. Docker overrides these three.
LH_DATABASE_URL=sqlite:///./lead_hunter_api.db
LH_REDIS_URL=redis://localhost:6379/0
LH_QUEUE_MODE=local
LH_MAX_ACCOUNTS=10
LH_API_REQUESTS_PER_MINUTE=120
LH_PROVIDER_REQUESTS_PER_MINUTE=60

# Approved Login Kit Web / Display API application, not Research or Business credentials.
LH_CLIENT_KEY=
LH_CLIENT_SECRET=
LH_REDIRECT_URI=https://localhost:8443/api/v1/oauth/callback

# Unofficial public search. Needs optional requirements and Chromium; disabled by default.
LH_EXPERIMENTAL_SEARCH_ENABLED=false
LH_EXPERIMENTAL_MS_TOKEN=

# Separate, approved NONCOMMERCIAL research project only. Never a leads data source.
LH_RESEARCH_ENABLED=false
LH_RESEARCH_PROJECT=
LH_RESEARCH_CLIENT_KEY=
LH_RESEARCH_CLIENT_SECRET=

# Compose infrastructure passwords; no external database/Redis ports are exposed.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
