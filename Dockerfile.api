FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /srv/app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt && useradd --create-home --uid 10001 leadhunter
COPY tiktok_api ./tiktok_api
COPY migrations ./migrations
COPY alembic.ini .
USER leadhunter
EXPOSE 8000
CMD ["uvicorn", "tiktok_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
